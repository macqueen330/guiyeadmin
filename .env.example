# =============================================================================
# GUIYE 瑰野 运营控制台 — 环境变量
# =============================================================================
# 用途：Claude Cloud 容器里「读写 Supabase + git」。不涉及 Vercel。
#
#   A 段  公开配置 → 直接贴进 Claude 环境的 Environment variables 框
#   B 段  写权限机密 → 要写库就绕不开，但那个框是明文可读的，看完说明再决定放法
#   git   不用配任何东西，见文末
#
# 本地开发：cp .env.example .env.local（.env.local 已被 gitignore）
# 容器部署：见 docs/cloud-container.md —— 默认网络策略不放行 Supabase，
#           不改的话所有请求都是 403，跟 key 对不对无关。
#
# 自检：npm run env:check
# =============================================================================


# -----------------------------------------------------------------------------
# A 段 · 公开配置（非机密，可进环境变量框）
# -----------------------------------------------------------------------------

# Supabase 项目地址与 anon key。
# anon key 本来就要发给浏览器、靠 RLS 兜底，**不是**机密。
# 当前 RLS 只有 `for select using (true)`，也就是 anon key 只能读、不能写。
# 取值：Supabase 控制台 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 项目 ref = 上面 URL 里 https:// 与 .supabase.co 之间那一段。
# npm run db:push 与 supabase CLI 都读它。
SUPABASE_PROJECT_ID=your-project-ref

# 站点地址，用于 metadata / canonical。
NEXT_PUBLIC_SITE_URL=https://guiye-admin.com

NEXT_TELEMETRY_DISABLED=1


# -----------------------------------------------------------------------------
# B 段 · 写权限机密（只读的话这段整个不用填）
# -----------------------------------------------------------------------------
# ⚠️ Claude Cloud 环境没有独立密钥存储，官方文档原话是环境变量框里的值
#    「anyone who uses the environment can read」。下面两个都是真机密。
#
#    三种放法，按你的场景挑：
#      1. 只读 → 两个都别填，A 段的 anon key 就够
#      2. 偶尔写 → 别存进框里，在会话里临时 export，用完就没了
#      3. 常态写 → 存进框里，接受它可读；建议独占环境 + 定期轮换
#
#    个人独占的环境里「可读」= 只有你自己可读，风险有限；
#    但环境一旦分享或被别人用，这两个值就一起给出去了。

# 数据面读写。绕过全部 RLS，等同数据库超级权限。
# 用到它的地方：npm run admin:create，以及任何要写业务表的脚本。
# 不填时应用退化为只读「演示模式」（内置超管身份），页面照常渲染。
# 取值：Supabase 控制台 → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# 管理面（跑迁移 / 执行任意 SQL）。npm run db:push 用它走 Management API。
# 注意：PAT 权限等同你**整个 Supabase 账号**，不限于本项目 —— 权限比上面那个还大。
# 只在要跑迁移时填，跑完吊销：supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# 数据库密码，只有 supabase CLI 非交互模式会用。
# 容器里**用不上** —— CLI 的 db push 走 5432 裸 TCP，出网代理不支持。
# 迁移一律用 npm run db:push。
# SUPABASE_DB_PASSWORD=


# -----------------------------------------------------------------------------
# git · 不用配
# -----------------------------------------------------------------------------
# 容器里 GitHub 走独立代理，不受网络白名单管，GH_TOKEN 读出来是占位符
# proxy-injected，真实凭据在容器外替换 —— clone / fetch / push 开箱即用。
#
# 唯一的坑：脚本自己 curl 仓库接口（/repos/{owner}/{repo}）会被拒 403，
# 提示需要连接 Claude GitHub App。推代码不受影响。详见 docs/cloud-container.md。
# GITHUB_TOKEN=
