# =============================================================================
# GUIYE 瑰野 运营控制台 — 环境变量
# =============================================================================
# 本文件按「放在哪里」分成三段，请勿整份复制到同一个地方：
#
#   A 段  公开配置    → 可以放进 Claude Cloud 环境的 Environment variables 框
#   B 段  运行时机密  → 只放 Vercel 项目环境变量（Sensitive），不要进容器
#   C 段  控制面令牌  → 只有当你确实要让容器直接调 Vercel / Supabase API 时才用
#
# 本地开发：cp .env.example .env.local，填 A+B 段即可（.env.local 已被 gitignore）。
# 容器部署：见 docs/cloud-container.md，先按那份文档改网络策略，否则一律 403。
#
# 自检：npm run env:check
# =============================================================================


# -----------------------------------------------------------------------------
# A 段 · 公开配置（非机密，可进 Claude 环境变量框）
# -----------------------------------------------------------------------------

# Supabase 项目地址与 anon key。
# anon key 本来就要发给浏览器，靠 RLS 兜底，因此**不是**机密——放环境变量框没问题。
# 取值：Supabase 控制台 → Project Settings → API。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 站点地址，用于 metadata / canonical。
NEXT_PUBLIC_SITE_URL=https://guiye-admin.com

# Supabase 项目 ref（就是上面 URL 里 https:// 和 .supabase.co 之间那一段）。
# scripts/db-push.mts 与 Supabase CLI 都读它。
SUPABASE_PROJECT_ID=your-project-ref

# Vercel 项目标识。两者都不是机密——它们本来就写在仓库的 .vercel/project.json 里。
# 取值：Vercel 项目 → Settings → General（或本地跑一次 npx vercel link 后看该文件）。
VERCEL_ORG_ID=team_xxxxxxxxxxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxx

# 关掉两个 CLI 的遥测，容器里少一次外呼。
NEXT_TELEMETRY_DISABLED=1
VERCEL_TELEMETRY_DISABLED=1


# -----------------------------------------------------------------------------
# B 段 · 运行时机密（只放 Vercel，不要进容器）
# -----------------------------------------------------------------------------

# service_role key 会绕过所有 RLS，等同于数据库超级权限。
# 缺它时应用退化为只读「演示模式」（内置超管身份），页面照常渲染。
# 正确位置：Vercel → Settings → Environment Variables，勾选 Sensitive，
#           且**不要**加 NEXT_PUBLIC_ 前缀。
# 取值：Supabase 控制台 → Project Settings → API → service_role。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# -----------------------------------------------------------------------------
# C 段 · 控制面令牌（容器直接操控 Vercel / Supabase 时才需要）
# -----------------------------------------------------------------------------
# ⚠️ Claude Cloud 环境目前**没有独立的密钥存储**，Environment variables 框里的值
#    「anyone who uses the environment can read」。放这三个等于把 Vercel 部署权
#    和 Supabase 账号权限明文留在环境配置里。
#
#    优先走 docs/cloud-container.md 的「零机密方案」：容器只 git push，
#    由 Vercel 的 Git 集成自动构建部署——那样这一段一个都不用填。
#
#    真要填，请用短期、窄权限的令牌，并在任务结束后立刻吊销。

# Vercel 部署令牌。取值：vercel.com/account/tokens（建议 Scope 选中单个项目，
# 有效期选最短）。vercel CLI 会自动读取，不要用 --token 传（会进 shell 历史）。
VERCEL_TOKEN=

# Supabase 个人访问令牌（PAT）。取值：supabase.com/dashboard/account/tokens。
# 注意：PAT 权限等同于你的整个 Supabase 账号，不限于本项目。
SUPABASE_ACCESS_TOKEN=

# 数据库密码，仅供 supabase CLI 非交互使用。
# 注意：容器内**用不上**——CLI 的 db push 走 5432 裸 TCP，代理不支持（见文档）。
#      迁移请改用 npm run db:push（走 Management API，HTTPS）。
SUPABASE_DB_PASSWORD=

# GitHub 一般**不用填**。容器里 GitHub 走独立代理，GH_TOKEN 读出来是占位符
# proxy-injected，git push / PR 操作都已经能用。只有当脚本要自己拿真 token
# 调 API 时才需要，填了就同样是明文可读。
# GITHUB_TOKEN=
