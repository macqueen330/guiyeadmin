# =============================================================================
# GUIYE 瑰野 · 运营控制台 —— 环境变量
#
# 注意：本系统**没有演示模式**。缺少下面「必填」的三项时，任何人都无法登录，
# 控制台只会显示一句「系统尚未配置」—— 而不是降级成一个无鉴权的超管入口。
# =============================================================================

# ---- 必填：Supabase（Project Settings → API）--------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 服务端专用，切勿加 NEXT_PUBLIC_ 前缀，也不要提交进仓库。
# 迁移 0008 之后 anon / authenticated 对所有业务表都是 0 条策略，
# 服务端在 requireAdmin() 通过之后才用这把 key 读写数据。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- 站点 -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://guiye-admin.com

# =============================================================================
# 以下全部可选。没配置的能力在界面上会明确显示「未接入 / 缺少配置」，
# 不会假装已经生效。
# =============================================================================

# ---- 官网埋点上报（/api/analytics/collect）----------------------------------
# ANALYTICS_INGEST_TOKEN：官网上报时带 X-Analytics-Token 头，留空则不校验。
# ANALYTICS_ALLOWED_ORIGIN：允许跨域上报的官网域名，留空则允许所有来源。
# 后台自身的页面浏览由 @vercel/analytics 采集，不走这个接口。
ANALYTICS_INGEST_TOKEN=
ANALYTICS_ALLOWED_ORIGIN=https://www.guiye.com

# ---- 微信支付 V3 ------------------------------------------------------------
# 回调地址：/api/pay/wechat_pay/notify
# 变量名要与 payment_gateways.credential_env 一致（默认 WECHAT_PAY_API_V3_KEY）。
WECHAT_PAY_API_V3_KEY=          # APIv3 密钥（32 位），用于解密回调 resource
WECHAT_PAY_PLATFORM_CERT=       # 微信支付平台证书（PEM），用于验签回调
WECHAT_PAY_PRIVATE_KEY=         # 商户 API 私钥（PEM），调用下单 / 退款接口
WECHAT_PAY_SERIAL_NO=           # 商户证书序列号

# ---- 支付宝 -----------------------------------------------------------------
# 回调地址：/api/pay/alipay/notify
ALIPAY_PRIVATE_KEY=             # 应用私钥（PEM 或 base64 单行）
ALIPAY_PUBLIC_KEY=              # 支付宝公钥，用于验签回调（RSA2）
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ---- 银联 -------------------------------------------------------------------
# 回调地址：/api/pay/unionpay/notify
UNIONPAY_PRIVATE_KEY=           # 商户私钥（PEM）
UNIONPAY_PUBLIC_KEY=            # 银联公钥，用于验签回调
UNIONPAY_CERT_ID=               # 证书序列号
UNIONPAY_CERT_PASSWORD=         # 证书口令（payment_gateways.credential_env 默认指向它）
UNIONPAY_GATEWAY=https://gateway.95516.com/gateway/api/back/action.do

# ---- 物流公司 API（可选，按需为每家承运商配置）-------------------------------
# 承运商是否接入由 carriers.api_provider 决定：
#   NULL   = 人工录单（默认，界面显示「人工录单」）
#   http   = 通用 REST 适配器，请求与字段映射写在 carriers.api_config
# 鉴权凭据同样只登记变量名：carriers.api_credential_env / carriers.webhook_secret_env
# 各自填一个变量名，值配置在这里。示例（顺丰）：
# SF_API_TOKEN=                 # carriers.api_credential_env = 'SF_API_TOKEN'
# SF_WEBHOOK_SECRET=            # carriers.webhook_secret_env = 'SF_WEBHOOK_SECRET'
#                               # Webhook 地址：/api/logistics/sf/webhook（HMAC-SHA256 验签）
